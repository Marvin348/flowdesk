{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown src/server.ts src/jobs/deadlineJob.ts src/workers/notificationWorker.ts --format esm --out-dir dist --clean",
    "start": "node dist/server.mjs",

    "job:deadlines:dev": "tsx src/jobs/deadlineJob.ts",
    "job:deadlines": "node dist/jobs/deadlineJob.mjs",

    "worker:notifications:dev": "tsx src/workers/notificationWorker.ts",
    "worker:notifications": "node dist/workers/notificationWorker.mjs",
    
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "redis": "^6.2.0",
    "resend": "^6.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
